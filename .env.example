# ==============================================================================
# FOURCRED V2 - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha as variáveis abaixo com os dados reais do seu projeto Supabase.
# 3. ATENÇÃO: Nunca comite o arquivo .env com credenciais reais em repositórios públicos.
# ==============================================================================

# Porta do Servidor Node.js Express (padrão: 3000)
PORT=3000

# URL da Aplicação (injetado automaticamente pelo AI Studio / Cloud Run)
APP_URL="http://localhost:3000"

# Chave de API Gemini (opcional, gerenciada pelo AI Studio UI)
GEMINI_API_KEY=""

# ==============================================================================
# SUPABASE POSTGRESQL & AUTH (BACKEND NODE.JS EXCLUSIVO)
# ==============================================================================
# SUPABASE_URL:
# A URL do seu projeto Supabase (encontrada em: Project Settings -> API -> Project URL)
# Exemplo: https://xyzcompany.supabase.co
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY:
# A chave de serviço secreta com privilégios de administração (Project Settings -> API -> Project API keys -> service_role).
# SEGURANÇA CRÍTICA:
# - Esta chave NUNCA deve ser exposta no frontend (React), no navegador ou em repositórios públicos.
# - Ela é lida EXCLUSIVAMENTE pelo servidor Node.js (server.ts) para realizar operações seguras.
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY (Opcional para cliente direto se necessário):
# Chave pública para futuras operações diretas com RLS
SUPABASE_ANON_KEY=""
